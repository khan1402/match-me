# Database Configuration
# For local development, use localhost:5432
# Update the username and password to match your PostgreSQL setup
DATABASE_URL=postgresql://matchme_user:matchme_password@localhost:5432/matchme

# JWT Secret (change this in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
NODE_ENV=development
PORT=3000

# Frontend Branding (optional)
VITE_APP_TITLE=Match Me
VITE_APP_LOGO=https://placehold.co/128x128/E1E7EF/1F2937?text=MatchMe

# Analytics (optional - leave empty if not using )
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
